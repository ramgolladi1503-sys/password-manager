{
  "id": "flow.acme-mail.change-password",
  "domain": "acme-mail.example",
  "version": "1.0.0",
  "modeSupport": ["auto", "guided"],
  "requires": {
    "authenticatedSession": true,
    "mfaSupported": true,
    "captchaHandled": "pause",
    "loginUrl": "https://acme-mail.example/login"
  },
  "bindings": ["old_password", "new_password"],
  "signals": {
    "captchaDetected": ["#captcha", ".hcaptcha", ".recaptcha"],
    "rateLimited": [".rate-limit", "text=Too many requests"],
    "mfaPrompt": ["input[name='otp']", "text=Enter code"]
  },
  "steps": [
    {
      "id": "nav-security",
      "label": "Open security settings",
      "mode": "auto",
      "action": "navigate",
      "target": "https://acme-mail.example/settings/security"
    },
    {
      "id": "open-change-password",
      "label": "Open change password",
      "mode": "auto",
      "action": "click",
      "selector": "button#change-password"
    },
    {
      "id": "fill-old",
      "label": "Enter current password",
      "mode": "guided",
      "action": "type",
      "selector": "input[name='currentPassword']",
      "value": "{{old_password}}"
    },
    {
      "id": "fill-new",
      "label": "Enter new password",
      "mode": "guided",
      "action": "type",
      "selector": "input[name='newPassword']",
      "value": "{{new_password}}"
    },
    {
      "id": "confirm-new",
      "label": "Confirm new password",
      "mode": "guided",
      "action": "type",
      "selector": "input[name='confirmPassword']",
      "value": "{{new_password}}"
    },
    {
      "id": "submit",
      "label": "Submit password change",
      "mode": "auto",
      "action": "click",
      "selector": "button[type='submit']"
    },
    {
      "id": "mfa-wait",
      "label": "Wait for MFA",
      "mode": "guided",
      "action": "pause_for_user",
      "condition": "signal:mfaPrompt"
    }
  ],
  "verify": [
    {
      "id": "old-fails",
      "label": "Old password should fail",
      "action": "assert_login_fails",
      "using": "{{old_password}}"
    },
    {
      "id": "new-works",
      "label": "New password should work",
      "action": "assert_login_succeeds",
      "using": "{{new_password}}"
    }
  ],
  "safety": {
    "maxAttempts": 2,
    "cooldownSeconds": 60,
    "lockoutGuard": true
  },
  "telemetry": {
    "emitEvents": ["flow_started", "step_completed", "flow_succeeded", "flow_failed"]
  }
}
