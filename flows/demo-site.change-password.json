{
  "id": "flow.demo-site.change-password",
  "domain": "localhost",
  "version": "1.0.0",
  "description": "Local demo site rotation flow for end-to-end validation.",
  "modeSupport": ["auto", "guided"],
  "requires": {
    "authenticatedSession": false,
    "mfaSupported": false,
    "captchaHandled": "ignore",
    "loginUrl": "http://localhost:4173/"
  },
  "bindings": ["username", "old_password", "new_password"],
  "signals": {
    "mfaPrompt": ["#mfa-overlay"]
  },
  "steps": [
    {
      "id": "open-site",
      "label": "Open demo site",
      "mode": "auto",
      "action": "navigate",
      "target": "http://localhost:4173/"
    },
    {
      "id": "enter-email",
      "label": "Enter email",
      "mode": "auto",
      "action": "type",
      "selector": "#login-email",
      "value": "{{username}}"
    },
    {
      "id": "enter-password",
      "label": "Enter current password",
      "mode": "auto",
      "action": "type",
      "selector": "#login-password",
      "value": "{{old_password}}"
    },
    {
      "id": "submit-login",
      "label": "Submit login",
      "mode": "auto",
      "action": "click",
      "selector": "#login-submit"
    },
    {
      "id": "open-settings",
      "label": "Open settings",
      "mode": "auto",
      "action": "click",
      "selector": "#nav-settings"
    },
    {
      "id": "open-password-tab",
      "label": "Open password tab",
      "mode": "auto",
      "action": "click",
      "selector": "#password-tab"
    },
    {
      "id": "fill-current",
      "label": "Enter current password",
      "mode": "auto",
      "action": "type",
      "selector": "#current-password",
      "value": "{{old_password}}"
    },
    {
      "id": "fill-new",
      "label": "Enter new password",
      "mode": "auto",
      "action": "type",
      "selector": "#new-password",
      "value": "{{new_password}}"
    },
    {
      "id": "confirm-new",
      "label": "Confirm new password",
      "mode": "auto",
      "action": "type",
      "selector": "#confirm-password",
      "value": "{{new_password}}"
    },
    {
      "id": "submit-password",
      "label": "Save password",
      "mode": "auto",
      "action": "click",
      "selector": "#save-password"
    },
    {
      "id": "confirm-success",
      "label": "Confirm success message",
      "mode": "auto",
      "action": "assert_text",
      "selector": "#toast-success",
      "value": "Password updated"
    }
  ],
  "verify": [
    {
      "id": "old-login-fails",
      "label": "Old password should fail",
      "action": "assert_login_fails",
      "using": "{{old_password}}",
      "selector": "#login-error"
    },
    {
      "id": "new-login-works",
      "label": "New password should succeed",
      "action": "assert_login_succeeds",
      "using": "{{new_password}}",
      "selector": "#dashboard-panel"
    }
  ],
  "safety": {
    "maxAttempts": 2,
    "cooldownSeconds": 10,
    "lockoutGuard": false
  }
}
