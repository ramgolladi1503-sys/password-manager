{
  "id": "flow.workboard.change-password",
  "domain": "workboard.example",
  "version": "1.0.0",
  "modeSupport": ["guided", "manual"],
  "requires": {
    "authenticatedSession": true,
    "mfaSupported": false,
    "captchaHandled": "pause",
    "loginUrl": "https://workboard.example/login"
  },
  "bindings": ["old_password", "new_password"],
  "signals": {
    "captchaDetected": ["#captcha", ".hcaptcha", ".recaptcha"],
    "rateLimited": ["text=Too many requests"]
  },
  "steps": [
    {
      "id": "nav-settings",
      "label": "Open profile settings",
      "mode": "guided",
      "action": "navigate",
      "target": "https://workboard.example/profile/settings"
    },
    {
      "id": "open-password-tab",
      "label": "Open password tab",
      "mode": "guided",
      "action": "click",
      "selector": "a#password-tab"
    },
    {
      "id": "fill-old",
      "label": "Enter current password",
      "mode": "guided",
      "action": "type",
      "selector": "input[name='current']",
      "value": "{{old_password}}"
    },
    {
      "id": "fill-new",
      "label": "Enter new password",
      "mode": "guided",
      "action": "type",
      "selector": "input[name='new']",
      "value": "{{new_password}}"
    },
    {
      "id": "confirm-new",
      "label": "Confirm new password",
      "mode": "guided",
      "action": "type",
      "selector": "input[name='confirm']",
      "value": "{{new_password}}"
    },
    {
      "id": "submit",
      "label": "Save changes",
      "mode": "guided",
      "action": "click",
      "selector": "button.save"
    }
  ],
  "verify": [
    {
      "id": "old-fails",
      "label": "Old password should fail",
      "action": "assert_login_fails",
      "using": "{{old_password}}"
    }
  ],
  "safety": {
    "maxAttempts": 2,
    "cooldownSeconds": 90,
    "lockoutGuard": true
  },
  "telemetry": {
    "emitEvents": ["flow_started", "step_completed", "flow_failed"]
  }
}
