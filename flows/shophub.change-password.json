{
  "id": "flow.shophub.change-password",
  "domain": "shophub.example",
  "version": "1.0.0",
  "modeSupport": ["auto"],
  "requires": {
    "authenticatedSession": true,
    "mfaSupported": true,
    "captchaHandled": "pause",
    "loginUrl": "https://shophub.example/login"
  },
  "bindings": ["old_password", "new_password"],
  "signals": {
    "captchaDetected": ["#captcha", ".hcaptcha", ".recaptcha"],
    "mfaPrompt": ["input[name='otp']", "text=Enter code"]
  },
  "steps": [
    {
      "id": "nav-security",
      "label": "Open account security",
      "mode": "auto",
      "action": "navigate",
      "target": "https://shophub.example/account/security"
    },
    {
      "id": "open-change-password",
      "label": "Open change password",
      "mode": "auto",
      "action": "click",
      "selector": "button[data-action='change-password']"
    },
    {
      "id": "fill-old",
      "label": "Enter current password",
      "mode": "auto",
      "action": "type",
      "selector": "input#old",
      "value": "{{old_password}}"
    },
    {
      "id": "fill-new",
      "label": "Enter new password",
      "mode": "auto",
      "action": "type",
      "selector": "input#new",
      "value": "{{new_password}}"
    },
    {
      "id": "confirm-new",
      "label": "Confirm new password",
      "mode": "auto",
      "action": "type",
      "selector": "input#confirm",
      "value": "{{new_password}}"
    },
    {
      "id": "submit",
      "label": "Submit",
      "mode": "auto",
      "action": "click",
      "selector": "button[type='submit']"
    },
    {
      "id": "mfa-wait",
      "label": "Wait for MFA",
      "mode": "guided",
      "action": "pause_for_user",
      "condition": "signal:mfaPrompt"
    }
  ],
  "safety": {
    "maxAttempts": 2,
    "cooldownSeconds": 60,
    "lockoutGuard": true
  },
  "telemetry": {
    "emitEvents": ["flow_started", "step_completed", "flow_succeeded", "flow_failed"]
  }
}
